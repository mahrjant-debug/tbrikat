rules_version = '2';

// قواعد Firestore لجدارية التهاني.
//
// المشرفون:
//  - المشرف الرئيسي (Owner): بريده مكتوب هنا في الدالتين isOwner و ownerEmail. لا يمكن حذفه ولا
//    حجب صلاحيته من لوحة التحكم، فلا يُقفل عليك الباب مهما حدث.
//  - بقية المشرفين: وثيقة في المجموعة admins معرّفها بريدهم بأحرف صغيرة. تُنشأ وتُحذف من تبويب «المشرفين».

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() {
      return 'butaqi2012@gmail.com';
    }

    function isOwner() {
      return request.auth != null && request.auth.token.email == ownerEmail();
    }

    // المشرف الرئيسي، أو من له وثيقة في admins (المعرّف = بريده)
    function isAdmin() {
      return isOwner()
        || (request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    function validAdminDoc(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.email is string && d.email == id
        && (d.role == 'admin' || d.role == 'owner');
    }

    // الاعتماد التلقائي مفعّل في الإعدادات ولا يشترط اعتماد المشرف
    function autoApproveOn() {
      return exists(/databases/$(database)/documents/settings/global)
        && get(/databases/$(database)/documents/settings/global).data.get('autoApprove', false) == true
        && get(/databases/$(database)/documents/settings/global).data.get('requireAdminApproval', false) != true;
    }

    function validNewCongrat() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'text', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'text', 'status', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 50
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 200
        && d.createdAt == request.time
        && (
          d.status == 'pending'
          || d.status == 'hidden'
          || (d.status == 'approved' && autoApproveOn())
        );
    }

    match /congratulations/{id} {
      allow read: if true;
      allow create: if validNewCongrat();
      allow update, delete: if isAdmin();
    }

    match /admins/{id} {
      allow read: if isAdmin();
      // إنشاء مشرف عادي لأي مشرف؛ وثيقة المشرف الرئيسي لا ينشئها إلا هو لنفسه
      allow create: if isAdmin()
        && validAdminDoc(id)
        && request.resource.data.createdAt == request.time
        && (request.resource.data.role == 'admin' || (isOwner() && id == ownerEmail()));
      // تعديل الاسم فقط؛ الدور والبريد وتاريخ الإنشاء ثابتة، ووثيقة المشرف الرئيسي له وحده
      allow update: if isAdmin()
        && validAdminDoc(id)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.role == 'admin' || isOwner());
      // لا يُحذف المشرف الرئيسي أبداً
      allow delete: if isAdmin() && resource.data.role == 'admin';
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // فيديوهات يوتيوب: معرّف الفيديو 11 حرفاً من [A-Za-z0-9_-]
    function validVideo() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'videoId', 'start', 'order', 'createdAt', 'scheduleAt', 'durationSec', 'repeatCount', 'repeatEveryMin', 'repeatUntil', 'enabled'])
        && d.keys().hasAll(['title', 'videoId', 'start', 'order', 'createdAt'])
        && d.title is string && d.title.size() <= 150
        && d.videoId is string && d.videoId.matches('^[A-Za-z0-9_-]{11}$')
        && d.start is number && d.start >= 0 && d.start <= 86400
        && d.order is number
        && d.get('scheduleAt', 0) is number && d.get('scheduleAt', 0) >= 0
        && d.get('durationSec', 0) is number && d.get('durationSec', 0) >= 0 && d.get('durationSec', 0) <= 86400
        && d.get('repeatCount', 1) is number && d.get('repeatCount', 1) >= 1 && d.get('repeatCount', 1) <= 100
        && d.get('repeatEveryMin', 10) is number && d.get('repeatEveryMin', 10) >= 1 && d.get('repeatEveryMin', 10) <= 1440
        && d.get('repeatUntil', 0) is number && d.get('repeatUntil', 0) >= 0
        && d.get('enabled', true) is bool;
    }

    match /videos/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validVideo();
      allow delete: if isAdmin();
    }

    match /bannedWords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // أي مسار آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
