rules_version = '2';

// قواعد Firestore لجدارية التهاني.
// عدّل قائمة بريد المشرفين أدناه (يجب أن تطابق حسابات Firebase Auth التي أنشأتها).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'admin@example.com'
        ];
    }

    // الاعتماد التلقائي مفعّل في الإعدادات ولا يشترط اعتماد المشرف
    function autoApproveOn() {
      return exists(/databases/$(database)/documents/settings/global)
        && get(/databases/$(database)/documents/settings/global).data.get('autoApprove', false) == true
        && get(/databases/$(database)/documents/settings/global).data.get('requireAdminApproval', false) != true;
    }

    function validNewCongrat() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'text', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'text', 'status', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 50
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 200
        && d.createdAt == request.time
        && (
          d.status == 'pending'
          || d.status == 'hidden'
          || (d.status == 'approved' && autoApproveOn())
        );
    }

    match /congratulations/{id} {
      allow read: if true;
      allow create: if validNewCongrat();
      allow update, delete: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bannedWords/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // أي مسار آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
